# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_SSL_MODE=PREFERRED
DB_NAME=examconnect
DB_USER=root
DB_PASSWORD=

# Server Configuration
PORT=8080

# Security / JWT
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# File Storage
STORAGE_UPLOAD_DIR=./uploads

# AI & RAG Configuration (Optional - platform functions with fallback if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SIMILARITY_THRESHOLD=0.25
AI_TOP_K=4

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin User
INITIAL_ADMIN_EMAIL=admin@examconnect.com
INITIAL_ADMIN_PASSWORD=
